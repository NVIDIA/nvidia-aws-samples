# Copy this file to terraform.tfvars and set EXACTLY ONE of the two variables
# below. The module conditionally dispatches on which one is populated.
#
# Path A (recommended) — Name of the Secrets Manager secret holding your NGC
# API key. The secret should be a JSON key/value with an `access-key` field,
# e.g. { "access-key": "nvapi-..." } (plaintext also works — see the README).
ngc_secret_name = "your-ngc-secret-name"

# Path B (dev-only) — Inline NGC API key. Uncomment + paste the raw key here
# and leave ngc_secret_name = null (or delete that line entirely). The value
# ends up in Terraform state — use only for local dev / short-lived POCs.
# ngc_api_key = "nvapi-XXXXXXXXXXXXXXXXXXXXXXXX"

# A standard NGC account with access to the Alpamayo NIM is sufficient — no
# special access-program entitlement is required for image pull from nvcr.io.
